<%@page contentType="text/html" pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Moffat Bay Lodge | Guest Access</title>

    <link rel="stylesheet"
          href="css/style.css">

</head>

<body class="guest-page">

    <!-- Navigation -->

    <header class="navbar">

        <div class="logo">

            <h2>Moffat Bay Lodge</h2>

        </div>

        <nav>

            <ul>

                <li>
                    <a href="index.jsp">Home</a>
                </li>

                <li>
                    <a href="login.jsp">Login</a>
                </li>

                <li>
                    <a href="register.jsp">Register</a>
                </li>

            </ul>

        </nav>

    </header>

    <!-- Hero Section -->

    <section class="hero-section">

        <div class="hero-overlay">

            <div class="hero-content">

                <h1>
                    Welcome Guest
                </h1>

                <p>
                    Explore Moffat Bay Lodge and discover
                    luxurious accommodations, exciting
                    adventure packages, and breathtaking
                    coastal scenery.
                </p>

                <div class="hero-buttons">

                    <a href="register.jsp"
                       class="btn-primary">

                        Create Account

                    </a>

                    <a href="login.jsp"
                       class="btn-secondary">

                        Member Login

                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- Featured Rooms -->

    <section class="content-section">

        <h2>Featured Accommodations</h2>

        <div class="service-grid">

            <div class="service-card">

                <h3>Ocean View Suite</h3>

                <p>
                    Enjoy stunning waterfront views
                    and premium comfort.
                </p>

            </div>

            <div class="service-card">

                <h3>Family Cabin</h3>

                <p>
                    Spacious accommodations perfect
                    for family vacations.
                </p>

            </div>

            <div class="service-card">

                <h3>Executive Retreat</h3>

                <p>
                    Luxury lodging for business and
                    executive travelers.
                </p>

            </div>

        </div>

    </section>

    <!-- Adventure Packages -->

    <section class="content-section">

        <h2>Adventure Packages</h2>

        <div class="service-grid">

            <div class="service-card">

                <h3>Kayaking Tours</h3>

                <p>
                    Explore beautiful coastal waterways
                    and marine wildlife.
                </p>

            </div>

            <div class="service-card">

                <h3>Fishing Excursions</h3>

                <p>
                    Guided fishing trips for beginners
                    and experienced anglers.
                </p>

            </div>

            <div class="service-card">

                <h3>Nature Hiking</h3>

                <p>
                    Experience scenic trails and
                    breathtaking landscapes.
                </p>

            </div>

        </div>

    </section>

    <!-- Guest Benefits -->

    <section class="content-section">

        <h2>Why Become a Member?</h2>

        <ul class="feature-list">

            <li>
                Manage reservations online
            </li>

            <li>
                Access special discounts
            </li>

            <li>
                Receive exclusive promotions
            </li>

            <li>
                Faster booking experience
            </li>

            <li>
                Personalized guest services
            </li>

        </ul>

    </section>

    <!-- Membership Call To Action -->

    <section class="content-section">

        <h2>Ready to Join?</h2>

        <p>
            Create a free account today and enjoy
            all the benefits available to
            Moffat Bay Lodge members.
        </p>

        <br>

        <a href="register.jsp"
           class="btn-primary">

            Create Free Account

        </a>

    </section>

    <!-- Footer -->

    <footer class="footer">

        <p>

            © 2026 Moffat Bay Lodge

            <br>

            Luxury Coastal Hospitality Experience

        </p>

    </footer>

